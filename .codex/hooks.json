{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\github\\rezidnt\\.codex\\hooks\\firewall.sh'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\github\\rezidnt\\.codex\\hooks\\ontology-gate.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\github\\rezidnt\\.codex\\hooks\\fmt.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash 'D:\\github\\rezidnt\\.codex\\hooks\\slice-status.sh'"
          }
        ]
      }
    ]
  }
}
